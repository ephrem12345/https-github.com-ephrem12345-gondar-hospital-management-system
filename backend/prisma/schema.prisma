model DispensingRecord {
  id                 String                    @id @default(uuid()) @db.Char(36)
  receiptNumber      String                    @unique @db.VarChar(40)
  prescriptionId     String                    @db.Char(36)
  prescriptionItemId String?                   @db.Char(36)
  patientId          String                    @db.Char(36)
  medicineId         String                    @db.Char(36)
