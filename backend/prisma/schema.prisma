generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMINISTRATOR
  PATIENT
  DOCTOR
  NURSE
  RECEPTIONIST
  LABORATORY_TECHNICIAN
  RADIOLOGY_TECHNICIAN
  PHARMACIST
  FINANCE_OFFICER
  HR_OFFICER
  DEPARTMENT_HEAD
  HOSPITAL_STAFF
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum PatientStatus {
  STABLE
  CRITICAL
  RECOVERING
  DISCHARGED
}

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  EMERGENCY
  PROCEDURE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  CONSULTING
  COMPLETED
  ABSENT
  TRANSFERRED
}

enum ClinicalEncounterStatus {
  ACTIVE
  COMPLETED
}

enum ClinicalRecordStatus {
  DRAFT
  FINALIZED
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum EmergencyCaseStatus {
  ARRIVAL
  TRIAGE
  WAITING
  ASSESSMENT
  TREATMENT
  OBSERVATION
  ADMISSION
  REFERRAL
  TRANSFER
  DISCHARGE
}

enum LaboratoryOrderStatus {
  PENDING
  ASSIGNED
  SPECIMEN_COLLECTED
  PROCESSING
  AWAITING_RESULT
  COMPLETED
  CANCELLED
}

enum LaboratoryResultStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  RELEASED
}

enum ImagingRequestStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BloodUnitStatus {
  QUARANTINED
  AVAILABLE
  RESERVED
  ISSUED
  RETURNED
  DISCARDED
}

enum ClinicalMessageCategory {
  CLINICAL_INSTRUCTION
  MEDICATION_ORDER
  NURSING_CARE
  VITAL_SIGNS_REQUEST
  LABORATORY_REQUEST
  LABORATORY_ALERT
  GENERAL_CONSULTATION
}

enum MessagePriority {
  ROUTINE
  IMPORTANT
  URGENT
  STAT
  CRITICAL
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  ACKNOWLEDGED
}

enum ConversationType {
  DIRECT
  DEPARTMENT
  GROUP
}

enum ClinicalTaskStatus {
  PENDING
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  INSURANCE
  CHAPA
}

enum PaymentStatus {
  VALIDATED
  REVERSED
}

enum RefundStatus {
  PENDING
  APPROVED
  PAID_OUT
  REJECTED
}

enum PortalNotificationCategory {
  APPOINTMENTS
  RESULTS
  BILLING
  HOSPITAL
}

enum SupportRequestCategory {
  FEEDBACK
  COMPLAINT
  SUPPORT_REQUEST
}

enum SupportRequestStatus {
  OPEN
  IN_REVIEW
  RESPONDED
  CLOSED
}

enum HospitalStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionTier {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

model Hospital {
  id                    String                 @id @default(uuid()) @db.Char(36)
  code                  String                 @unique @db.VarChar(60)
  name                  String                 @db.VarChar(160)
  logoUrl               String?                @db.VarChar(500)
  bannerUrl             String?                @db.VarChar(500)
  address               String?                @db.VarChar(255)
  city                  String?                @db.VarChar(80)
  region                String?                @db.VarChar(80)
  phone                 String                 @db.VarChar(32)
  email                 String                 @unique @db.VarChar(254)
  hospitalType          String                 @default("GENERAL") @db.VarChar(60)
  status                HospitalStatus         @default(TRIAL)
  tier                  SubscriptionTier       @default(BASIC)
  contactPerson         String?                @db.VarChar(120)
  contactPhone          String?                @db.VarChar(32)
  maxStaff              Int                    @default(50)
  maxPatients           Int                    @default(1000)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  users                 User[]
  patients              Patient[]
  subscriptions         HospitalSubscription[]
  invoices              Invoice[]
  payments              Payment[]
  appointments          Appointment[]
  conversations         Conversation[]
  assets                HospitalAsset[]

  @@index([status, createdAt])
  @@index([tier])
}

model SubscriptionPlan {
  id                    String                 @id @default(uuid()) @db.Char(36)
  code                  SubscriptionTier       @unique
  name                  String                 @db.VarChar(100)
  description           String?                @db.VarChar(500)
  monthlyPrice          Decimal                @db.Decimal(12, 2)
  annualPrice           Decimal                @db.Decimal(12, 2)
  maxStaff              Int                    @default(50)
  maxPatients           Int                    @default(1000)
  features              String                 @db.Text
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  subscriptions         HospitalSubscription[]

  @@index([isActive])
}

model HospitalSubscription {
  id                    String                 @id @default(uuid()) @db.Char(36)
  hospitalId            String                 @db.Char(36)
  planId                String                 @db.Char(36)
  status                SubscriptionStatus     @default(TRIAL)
  cycle                 BillingCycle           @default(MONTHLY)
  amount                Decimal                @db.Decimal(12, 2)
  currency              String                 @default("ETB") @db.Char(3)
  currentPeriodStart    DateTime               @default(now())
  currentPeriodEnd      DateTime
  trialEndsAt           DateTime?
  gracePeriodDays       Int                    @default(7)
  autoRenew             Boolean                @default(true)
  paymentReference      String?                @db.VarChar(120)
  canceledAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  hospital              Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  plan                  SubscriptionPlan       @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([hospitalId, status])
  @@index([status, currentPeriodEnd])
}

model User {
  id              String        @id @default(uuid()) @db.Char(36)
  email           String        @unique @db.VarChar(254)
  username        String?       @unique @db.VarChar(80)
  phone           String?       @unique @db.VarChar(32)
  passwordHash    String        @db.VarChar(255)
  role            UserRole      @default(PATIENT)
  status          AccountStatus @default(PENDING)
  firstName       String        @db.VarChar(50)
  middleName      String?       @db.VarChar(50)
  lastName        String        @db.VarChar(50)
  department      String?       @db.VarChar(100)
  hospitalId      String?       @db.Char(36)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  hospital        Hospital?     @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  patient         Patient?
  doctor          Doctor?
  appointments    Appointment[] @relation("AppointmentCreator")
  refreshSessions RefreshSession[]
  passwordResets  PasswordReset[]
  auditEvents     AuditLog[]    @relation("AuditActor")
  clinicalEncounters ClinicalEncounter[] @relation("EncounterCreator")
  consultationNotes ConsultationNote[] @relation("ConsultationAuthor")
  nursingNotes NursingNote[] @relation("NursingAuthor")
  vitalObservations VitalSignObservation[] @relation("VitalRecorder")
  diagnoses DiagnosisRecord[] @relation("DiagnosisAuthor")
  allergyRecords AllergyRecord[] @relation("AllergyAuthor")
  treatmentPlans TreatmentPlanRecord[] @relation("TreatmentAuthor")
  clinicalReferrals ClinicalReferral[] @relation("ReferralAuthor")
  clinicalAmendments ClinicalAmendment[] @relation("AmendmentAuthor")
  emergencyCases EmergencyCase[] @relation("EmergencyCaseCreator")
  emergencyTriages EmergencyTriage[] @relation("TriageAuthor")
  emergencyEvents EmergencyWorkflowEvent[] @relation("EmergencyEventAuthor")
  emergencyConsultations EmergencyConsultation[] @relation("EmergencyConsultationAuthor")
  departmentAssignments DepartmentAssignment[] @relation("DepartmentAssignmentAuthor")
  departmentWorkflows DepartmentWorkflowRecord[] @relation("DepartmentWorkflowAuthor")
  laboratoryOrders LaboratoryOrder[] @relation("LaboratoryOrderAuthor")
  laboratoryAssignments LaboratoryOrder[] @relation("LaboratoryOrderAssignee")
  specimens LaboratorySpecimen[] @relation("SpecimenCollector")
  laboratoryResults LaboratoryResult[] @relation("LaboratoryResultAuthor")
  laboratoryReviews LaboratoryResult[] @relation("LaboratoryResultReviewer")
  laboratoryAmendments LaboratoryResultAmendment[] @relation("LaboratoryAmendmentAuthor")
  radiologyRequests RadiologyRequest[] @relation("RadiologyRequestAuthor")
  imagingReports ImagingReport[] @relation("ImagingReportAuthor")
  imagingReviews ImagingReport[] @relation("ImagingReportReviewer")
  bloodDonors BloodDonor[] @relation("DonorRegistrar")
  bloodDonations BloodDonation[] @relation("DonationRecorder")
  bloodRequests BloodRequest[] @relation("BloodRequestAuthor")
  bloodCrossmatches BloodCrossmatch[] @relation("CrossmatchAuthor")
  bloodIssues BloodIssue[] @relation("BloodIssueAuthor")
  invoicesCreated Invoice[] @relation("InvoiceCreator")
  discountsApproved Invoice[] @relation("InvoiceDiscountApprover")
  paymentsReceived Payment[] @relation("PaymentReceiver")
  refundsCreated RefundRequest[] @relation("RefundRequester")
  refundsApproved RefundRequest[] @relation("RefundApprover")
  refundsPaid RefundRequest[] @relation("RefundPayer")
  employees Employee[]
  attendanceEvents AttendanceRecord[] @relation("AttendanceRecorder")
  leaveRequests LeaveRequest[] @relation("LeaveRequester")
  leaveApprovals LeaveRequest[] @relation("LeaveApprover")
  shifts ShiftAssignment[]
  payslips PayrollRecord[] @relation("PayrollCreator")
  payrollApprovals PayrollRecord[] @relation("PayrollApprover")
  portalNotifications PortalNotification[]
  supportRequestsCreated PortalSupportRequest[] @relation("SupportRequester")
  supportRequestsAssigned PortalSupportRequest[] @relation("SupportHandler")
  prescriptionsIssued   PharmacyPrescription[] @relation("PrescriptionDoctor")
  dispensingPerformed   DispensingRecord[]     @relation("DispensingPharmacist")
  admissionsCreated     InpatientAdmission[]   @relation("AdmissionDoctor")
  dischargesAuthorized  InpatientDischarge[]   @relation("DischargeAuthorizer")
  transfusionsAdministered TransfusionRecord[] @relation("TransfusionClinician")
  sentClinicalMessages     ClinicalMessage[]      @relation("SentClinicalMessages")
  receivedClinicalMessages ClinicalMessage[]      @relation("ReceivedClinicalMessages")
  messageRecipients        MessageRecipient[]
  messageReadReceipts      MessageReadReceipt[]
  clinicalNotifications    ClinicalNotification[]
  conversationsCreated     Conversation[]         @relation("ConversationsCreated")
  conversationMemberships  ConversationMember[]
  acknowledgedMessages     ClinicalMessage[]      @relation("MessageAcknowledger")
  escalatedMessages        ClinicalMessage[]      @relation("MessageEscalatedSupervisor")
  messageAcknowledgments   MessageAcknowledgment[]
  tasksCreated             ClinicalTask[]         @relation("TasksCreated")
  tasksAssigned            ClinicalTask[]         @relation("TasksAssigned")
  attachmentsUploaded      MessageAttachment[]    @relation("AttachmentUploader")
  communicationSettings    UserCommunicationSettings?

  @@index([role, status])
  @@index([hospitalId, role])
}

model Patient {
  id                    String        @id @default(uuid()) @db.Char(36)
  patientNumber         String        @unique @db.VarChar(32)
  hospitalId            String?       @db.Char(36)
  userId                String?       @unique @db.Char(36)
  firstName             String        @db.VarChar(50)
  middleName            String?       @db.VarChar(50)
  lastName              String        @db.VarChar(50)
  sex                   String        @db.VarChar(20)
  dateOfBirth           DateTime      @db.Date
  phone                 String        @db.VarChar(32)
  alternativePhone      String?       @db.VarChar(32)
  email                 String?       @db.VarChar(254)
  region                String?       @db.VarChar(80)
  zone                  String?       @db.VarChar(80)
  city                  String?       @db.VarChar(80)
  woreda                String?       @db.VarChar(80)
  kebele                String?       @db.VarChar(80)
  address               String?       @db.VarChar(255)
  bloodGroup            String?       @db.VarChar(10)
  allergies             String?       @db.Text
  medicalConditions     String?       @db.Text
  emergencyContactName  String?       @db.VarChar(100)
  emergencyRelationship String?       @db.VarChar(60)
  emergencyPhone        String?       @db.VarChar(32)
  emergencyAddress      String?       @db.VarChar(255)
  guardianName          String?       @db.VarChar(100)
  guardianRelationship  String?       @db.VarChar(60)
  guardianContact       String?       @db.VarChar(120)
  insuranceProvider     String?       @db.VarChar(100)
  policyNumber          String?       @db.VarChar(100)
  coverageDetails       String?       @db.VarChar(255)
  department            String        @db.VarChar(100)
  status                PatientStatus @default(STABLE)
  registeredAt          DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  hospital              Hospital?     @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  appointments          Appointment[]
  queueEntries          QueueEntry[]
  clinicalEncounters    ClinicalEncounter[]
  consultationNotes     ConsultationNote[]
  nursingNotes          NursingNote[]
  vitalObservations     VitalSignObservation[]
  diagnoses             DiagnosisRecord[]
  allergyRecords        AllergyRecord[]
  treatmentPlans        TreatmentPlanRecord[]
  clinicalReferrals     ClinicalReferral[]
  emergencyCases        EmergencyCase[]
  departmentAssignments DepartmentAssignment[]
  departmentWorkflows   DepartmentWorkflowRecord[]
  laboratoryOrders      LaboratoryOrder[]
  radiologyRequests     RadiologyRequest[]
  bloodDonations        BloodDonation[]
  bloodRequests         BloodRequest[]
  invoices              Invoice[]
  insurancePolicies     PatientInsurancePolicy[]
  insuranceClaims       InsuranceClaim[]
  portalNotifications   PortalNotification[]
  portalSupportRequests PortalSupportRequest[]
  prescriptions         PharmacyPrescription[]
  dispensingRecords     DispensingRecord[]
  inpatientAdmissions   InpatientAdmission[]
  inpatientDischarges   InpatientDischarge[]
  operatingRoomSchedules OperatingRoom[]
  ambulanceTrips        AmbulanceTrip[]
  diagnosticAttachments DiagnosticAttachment[]
  transfusions          TransfusionRecord[]
  assignedBeds          Bed[]
  clinicalMessages      ClinicalMessage[]
  conversations         Conversation[]
  clinicalTasks         ClinicalTask[]

  @@index([firstName, lastName])
  @@index([phone])
  @@index([registeredAt, status, department])
  @@index([hospitalId, patientNumber])
}

model Doctor {
  id           String           @id @default(uuid()) @db.Char(36)
  userId       String?          @unique @db.Char(36)
  name         String           @db.VarChar(120)
  specialty    String           @db.VarChar(100)
  department   String           @db.VarChar(100)
  active       Boolean          @default(true)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  schedules    DoctorSchedule[]
  leavePeriods DoctorLeave[]
  appointments Appointment[]
  queueEntries QueueEntry[]

  @@index([department, active])
  @@index([name])
}

model DoctorSchedule {
  id              String   @id @default(uuid()) @db.Char(36)
  doctorId        String   @db.Char(36)
  department      String   @db.VarChar(100)
  dayOfWeek       Int
  startTime       String   @db.Char(5)
  endTime         String   @db.Char(5)
  breakStart      String?  @db.Char(5)
  breakEnd        String?  @db.Char(5)
  slotDurationMins Int     @default(30)
  doctor          Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek, department])
}

model DoctorLeave {
  id        String   @id @default(uuid()) @db.Char(36)
  doctorId  String   @db.Char(36)
  startsAt  DateTime
  endsAt    DateTime
  reason    String?  @db.VarChar(255)
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startsAt, endsAt])
}

model Appointment {
  id          String            @id @default(uuid()) @db.Char(36)
  patientId   String            @db.Char(36)
  doctorId    String            @db.Char(36)
  hospitalId  String?           @db.Char(36)
  department  String            @db.VarChar(100)
  scheduledAt DateTime
  type        AppointmentType
  reason      String            @db.VarChar(200)
  notes       String?           @db.VarChar(500)
  status      AppointmentStatus @default(SCHEDULED)
  createdById String            @db.Char(36)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor      Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdBy   User              @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  hospital    Hospital?         @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  slotLock    AppointmentSlotLock?
  queueEntry  QueueEntry?

  @@index([scheduledAt, department, status])
  @@index([patientId, scheduledAt])
  @@index([doctorId, scheduledAt, status])
  @@index([hospitalId, scheduledAt])
}

model AppointmentSlotLock {
  id            String      @id @default(uuid()) @db.Char(36)
  appointmentId String      @unique @db.Char(36)
  doctorId      String      @db.Char(36)
  scheduledAt   DateTime
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([doctorId, scheduledAt])
}

model QueueCounter {
  id         String   @id @default(uuid()) @db.Char(36)
  department String   @db.VarChar(100)
  queueDate  DateTime @db.Date
  lastNumber Int      @default(0)

  @@unique([department, queueDate])
}

model QueueEntry {
  id            String      @id @default(uuid()) @db.Char(36)
  queueNumber   Int
  queueDate     DateTime    @db.Date
  patientId     String      @db.Char(36)
  appointmentId String?     @unique @db.Char(36)
  department    String      @db.VarChar(100)
  doctorId      String?     @db.Char(36)
  status        QueueStatus @default(WAITING)
  checkedInAt   DateTime    @default(now())
  completedAt   DateTime?
  patient       Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  doctor        Doctor?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@unique([department, queueDate, queueNumber])
  @@index([department, queueDate, status, queueNumber])
}

model RefreshSession {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  tokenHash String   @unique @db.VarChar(64)
  rememberMe Boolean @default(true)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, revokedAt])
}

model PasswordReset {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, usedAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String?  @db.Char(36)
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(80)
  entityId   String?  @db.VarChar(80)
  requestId  String?  @db.VarChar(64)
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model ClinicalEncounter {
  id          String                  @id @default(uuid()) @db.Char(36)
  patientId   String                  @db.Char(36)
  department  String                  @db.VarChar(100)
  clinicianId String                  @db.Char(36)
  startedAt   DateTime                @default(now())
  completedAt DateTime?
  status      ClinicalEncounterStatus @default(ACTIVE)
  createdAt   DateTime                @default(now())
  patient     Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinician   User                    @relation("EncounterCreator", fields: [clinicianId], references: [id], onDelete: Restrict)
  consultations ConsultationNote[]
  nursingNotes NursingNote[]
  vitalObservations VitalSignObservation[]
  diagnoses DiagnosisRecord[]
  treatmentPlans TreatmentPlanRecord[]
  referrals ClinicalReferral[]
  departmentWorkflows DepartmentWorkflowRecord[]
  prescriptions PharmacyPrescription[]

  @@index([patientId, startedAt])
  @@index([department, status, startedAt])
}

model ConsultationNote {
  id          String              @id @default(uuid()) @db.Char(36)
  patientId   String              @db.Char(36)
  encounterId String?             @db.Char(36)
  authorId    String              @db.Char(36)
  data        Json
  status      ClinicalRecordStatus @default(DRAFT)
  recordedAt  DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter   ClinicalEncounter?  @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  author      User                @relation("ConsultationAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([patientId, recordedAt])
  @@index([encounterId, status])
}

model NursingNote {
  id          String              @id @default(uuid()) @db.Char(36)
  patientId   String              @db.Char(36)
  encounterId String?             @db.Char(36)
  authorId    String              @db.Char(36)
  data        Json
  status      ClinicalRecordStatus @default(FINALIZED)
  recordedAt  DateTime            @default(now())
  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter   ClinicalEncounter?  @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  author      User                @relation("NursingAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([patientId, recordedAt])
  @@index([encounterId, recordedAt])
}

model VitalSignObservation {
  id                String             @id @default(uuid()) @db.Char(36)
  patientId         String             @db.Char(36)
  encounterId       String?            @db.Char(36)
  recordedById      String             @db.Char(36)
  recordedAt        DateTime           @default(now())
  bloodPressure     String             @db.VarChar(16)
  bloodPressureUnit String             @default("mmHg") @db.VarChar(12)
  heartRate         Float
  heartRateUnit     String             @default("bpm") @db.VarChar(12)
  respiratoryRate   Float
  respiratoryUnit   String             @default("breaths/min") @db.VarChar(20)
  temperature       Float
  temperatureUnit   String             @default("C") @db.VarChar(8)
  oxygenSaturation  Float
  oxygenUnit        String             @default("%") @db.VarChar(8)
  weight            Float
  weightUnit        String             @default("kg") @db.VarChar(8)
  height            Float
  heightUnit        String             @default("cm") @db.VarChar(8)
  painScore         Int
  painScale         String             @default("0-10") @db.VarChar(16)
  otherObservations Json?
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter         ClinicalEncounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  recordedBy        User               @relation("VitalRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([patientId, recordedAt])
  @@index([encounterId, recordedAt])
}

model DiagnosisRecord {
  id          String             @id @default(uuid()) @db.Char(36)
  patientId   String             @db.Char(36)
  encounterId String?            @db.Char(36)
  authorId    String             @db.Char(36)
  diagnosis   String             @db.VarChar(300)
  code        String?            @db.VarChar(30)
  diagnosedAt DateTime
  clinician   String             @db.VarChar(120)
  clinicalNotes String?          @db.Text
  isPrimary   Boolean            @default(false)
  recordedAt  DateTime           @default(now())
  patient     Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter   ClinicalEncounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  author      User               @relation("DiagnosisAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([patientId, diagnosedAt])
  @@index([encounterId, diagnosedAt])
}

model AllergyRecord {
  id                String   @id @default(uuid()) @db.Char(36)
  patientId         String   @db.Char(36)
  authorId          String   @db.Char(36)
  allergyName       String   @db.VarChar(120)
  reaction          String   @db.VarChar(300)
  severity          String   @db.VarChar(20)
