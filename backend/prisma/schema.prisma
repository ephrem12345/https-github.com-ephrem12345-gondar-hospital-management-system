  adverseReactions String?       @db.Text
  patient          Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  bloodUnit        BloodBankUnit @relation(fields: [bloodUnitId], references: [id], onDelete: Restrict)
  administeredBy   User          @relation("TransfusionClinician", fields: [administeredById], references: [id], onDelete: Restrict)

  @@index([patientId, startedAt])
  @@index([bloodUnitId])
}

model ClinicalMessage {
  id                  String                  @id @default(uuid()) @db.Char(36)
  conversationId      String?                 @db.Char(36)
  senderId            String                  @db.Char(36)
  recipientId         String?                 @db.Char(36)
  recipientRole       UserRole?
  patientId           String?                 @db.Char(36)
  department          String                  @db.VarChar(100)
  category            ClinicalMessageCategory @default(CLINICAL_INSTRUCTION)
  priority            MessagePriority         @default(ROUTINE)
  subject             String                  @db.VarChar(200)
  content             String                  @db.Text
  status              MessageStatus           @default(SENT)
  parentMessageId     String?                 @db.Char(36)
  laboratoryOrderId   String?                 @db.Char(36)
  acknowledgedAt      DateTime?
  acknowledgedById    String?                 @db.Char(36)
  acknowledgmentNotes String?                 @db.VarChar(500)
  isEscalated         Boolean                 @default(false)
  escalatedAt         DateTime?
  escalatedToId       String?                 @db.Char(36)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  conversation        Conversation?           @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  sender              User                    @relation("SentClinicalMessages", fields: [senderId], references: [id], onDelete: Restrict)
  recipient           User?                   @relation("ReceivedClinicalMessages", fields: [recipientId], references: [id], onDelete: SetNull)
  patient             Patient?                @relation(fields: [patientId], references: [id], onDelete: SetNull)
  parentMessage       ClinicalMessage?        @relation("MessageThread", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies             ClinicalMessage[]       @relation("MessageThread")
  recipients          MessageRecipient[]
  readReceipts        MessageReadReceipt[]
  acknowledgments     MessageAcknowledgment[]
  attachments         MessageAttachment[]
  tasks               ClinicalTask[]
  notifications       ClinicalNotification[]
  laboratoryOrder     LaboratoryOrder?        @relation(fields: [laboratoryOrderId], references: [id], onDelete: SetNull)
  acknowledgedBy      User?                   @relation("MessageAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  escalatedTo         User?                   @relation("MessageEscalatedSupervisor", fields: [escalatedToId], references: [id], onDelete: SetNull)

  @@index([senderId, createdAt])
  @@index([recipientId, status, createdAt])
  @@index([patientId, createdAt])
  @@index([department, category, createdAt])
  @@index([conversationId])
}

model MessageRecipient {
  id          String        @id @default(uuid()) @db.Char(36)
  messageId   String        @db.Char(36)
  userId      String        @db.Char(36)
  status      MessageStatus @default(SENT)
  deliveredAt DateTime?
  readAt      DateTime?

  message     ClinicalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, status])
}

model MessageReadReceipt {
  id        String          @id @default(uuid()) @db.Char(36)
  messageId String          @db.Char(36)
  userId    String          @db.Char(36)
  readAt    DateTime        @default(now())

  message   ClinicalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model ClinicalNotification {
  id                String          @id @default(uuid()) @db.Char(36)
  userId            String          @db.Char(36)
  messageId         String?         @db.Char(36)
  laboratoryOrderId String?         @db.Char(36)
  title             String          @db.VarChar(150)
  body              String          @db.VarChar(300)
  category          String          @db.VarChar(50)
  priority          MessagePriority @default(ROUTINE)
  read              Boolean         @default(false)
  createdAt         DateTime        @default(now())

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  message           ClinicalMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  laboratoryOrder   LaboratoryOrder? @relation(fields: [laboratoryOrderId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
}

model Conversation {
  id          String               @id @default(uuid()) @db.Char(36)
  type        ConversationType     @default(DIRECT)
  title       String?              @db.VarChar(150)
  department  String?              @db.VarChar(100)
  hospitalId  String?              @db.Char(36)
  patientId   String?              @db.Char(36)
  createdById String               @db.Char(36)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  hospital    Hospital?            @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  createdBy   User                 @relation("ConversationsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  patient     Patient?             @relation(fields: [patientId], references: [id], onDelete: SetNull)
  members     ConversationMember[]
  messages    ClinicalMessage[]
  tasks       ClinicalTask[]

  @@index([type, department])
  @@index([patientId])
  @@index([hospitalId])
}

model ConversationMember {
  id             String       @id @default(uuid()) @db.Char(36)
  conversationId String       @db.Char(36)
  userId         String       @db.Char(36)
  role           String       @default("MEMBER") @db.VarChar(30)
  muted          Boolean      @default(false)
  joinedAt       DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ClinicalTask {
  id              String             @id @default(uuid()) @db.Char(36)
  taskNumber      String             @unique @db.VarChar(40)
  messageId       String?            @db.Char(36)
  conversationId  String?            @db.Char(36)
  patientId       String?            @db.Char(36)
  department      String             @db.VarChar(100)
  taskType        String             @db.VarChar(50)
  title           String             @db.VarChar(200)
  description     String?            @db.Text
  priority        MessagePriority    @default(ROUTINE)
  status          ClinicalTaskStatus @default(PENDING)
  createdById     String             @db.Char(36)
  assignedToId    String?            @db.Char(36)
  dueAt           DateTime?
  acknowledgedAt  DateTime?
  completedAt     DateTime?
  completionNotes String?            @db.Text
  isEscalated     Boolean            @default(false)
  escalatedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  createdBy       User               @relation("TasksCreated", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo      User?              @relation("TasksAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  patient         Patient?           @relation(fields: [patientId], references: [id], onDelete: SetNull)
  message         ClinicalMessage?   @relation(fields: [messageId], references: [id], onDelete: SetNull)
  conversation    Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([assignedToId, status, priority])
  @@index([patientId, createdAt])
  @@index([department, status])
}

model MessageAcknowledgment {
  id             String          @id @default(uuid()) @db.Char(36)
  messageId      String          @db.Char(36)
  userId         String          @db.Char(36)
  notes          String?         @db.VarChar(500)
  acknowledgedAt DateTime        @default(now())

  message        ClinicalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model MessageAttachment {
  id           String          @id @default(uuid()) @db.Char(36)
  messageId    String          @db.Char(36)
  fileName     String          @db.VarChar(255)
  fileType     String          @db.VarChar(100)
  fileSize     Int
  storageKey   String          @db.VarChar(255)
  uploadedById String          @db.Char(36)
  createdAt    DateTime        @default(now())

  message      ClinicalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy   User            @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([messageId])
}

model UserCommunicationSettings {
  id                      String          @id @default(uuid()) @db.Char(36)
  userId                  String          @unique @db.Char(36)
  availabilityStatus      String          @default("ONLINE") @db.VarChar(30)
  statusMessage           String?         @db.VarChar(150)
  soundEnabled            Boolean         @default(true)
  emailNotifications      Boolean         @default(false)
  minNotificationPriority MessagePriority @default(ROUTINE)
  preferredLanguage       String          @default("en") @db.VarChar(10)
  autoEscalationPolicy    Boolean         @default(true)
  updatedAt               DateTime        @updatedAt

  user                    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}
