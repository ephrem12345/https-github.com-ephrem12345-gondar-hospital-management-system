# GHMS Backend Environment Template
# Copy this file to backend/.env and replace placeholders with your actual configuration.

NODE_ENV=development
PORT=4000
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002

# Database Connection (MySQL / MariaDB)
DATABASE_URL=mysql://ghms_user:your_password_here@localhost:3306/ghms?connection_limit=20&pool_timeout=10

# Authentication & JWT Configuration
# Generate a cryptographically random string (e.g., node -e "console.log(crypto.randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_here
JWT_ACCESS_TTL_SECONDS=900
COOKIE_SECURE=false
LOG_LEVEL=warn

# Seed Credentials (used when running `npx prisma db seed`)
GHMS_SEED_STAFF_PASSWORD=your_secure_staff_seed_password
GHMS_SEED_PATIENT_PASSWORD=your_secure_patient_seed_password

# Test Credentials (used by automated integration & security verification scripts)
GHMS_TEST_ADMIN_PASSWORD=your_test_admin_password
GHMS_TEST_DOCTOR_PASSWORD=your_test_doctor_password
GHMS_TEST_STAFF_PASSWORD=your_test_staff_password
GHMS_TEST_PATIENT_PASSWORD=your_test_patient_password

# Chapa Payment Gateway Configuration
PAYMENT_GATEWAY=chapa
CHAPA_MODE=test
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-your_chapa_public_key
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_secret_key
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here
CHAPA_REQUEST_TIMEOUT_MS=15000

# Application URLs
FRONTEND_URL=http://localhost:3002
BACKEND_PUBLIC_URL=http://localhost:4000

# Cloudinary Storage Configuration (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_BASE_URL=https://api.cloudinary.com/v1_1

# Subscription Background Jobs
SUBSCRIPTION_JOB_ENABLED=false
SUBSCRIPTION_JOB_INTERVAL_MINUTES=60
CRON_SECRET=your_cron_secret_min_16_chars_here
TRIAL_DAYS=14
TRIAL_GRACE_DAYS=3
SUBSCRIPTION_GRACE_DAYS=7
