{
  "name": "ghms-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Gondar Hospital Management System API",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run src/modules/portal/schemas.test.ts src/modules/auth/schemas.test.ts src/modules/emergency/schemas.test.ts",
    "test:security": "vitest run src/middleware/rbac.security.test.ts src/middleware/penetration.security.test.ts src/middleware/csrf.test.ts src/modules/auth/service.lockout.test.ts src/modules/auth/password-reset.security.test.ts",
    "test:services": "vitest run src/modules/saas/service.test.ts src/modules/payments/chapa.service.test.ts src/modules/clinical-messaging/messaging.test.ts src/modules/media/service.test.ts src/modules/payments/chapa.gateway.test.ts",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema=prisma/schema.prisma"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "^6.19.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
