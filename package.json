{
  "name": "ghms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean:cache": "node scripts/clean-next-cache.cjs --dev",
    "clean:prod": "node scripts/clean-next-cache.cjs --prod",
    "clean:all": "node scripts/clean-next-cache.cjs --all",
    "dev": "node scripts/dev-unified.cjs",
    "dev:frontend": "next dev -p 3002 -H 0.0.0.0",
    "dev:backend": "npm --prefix backend run dev",
    "dev:3000": "next dev -p 3000 -H 0.0.0.0",
    "dev:3002": "next dev -p 3002 -H 0.0.0.0",
    "dev:safe": "powershell -ExecutionPolicy Bypass -File ./scripts/start-ghms.ps1",
    "prestart": "node scripts/verify-build.cjs",
    "build": "next build",
    "start": "next start -p 3002 -H 0.0.0.0",
    "start:frontend": "next start -p 3002 -H 0.0.0.0",
    "start:3000": "next start -p 3000 -H 0.0.0.0",
    "start:3002": "next start -p 3002 -H 0.0.0.0",
    "health": "powershell -ExecutionPolicy Bypass -File ./scripts/check-ghms.ps1",
    "watchdog": "powershell -ExecutionPolicy Bypass -File ./scripts/watchdog.ps1 -AutoRecover",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:unit": "vitest run src/config src/data src/lib src/validation",
    "test:components": "vitest run src/components src/app",
    "test:middleware": "vitest run src/middleware.test.ts",
    "test:security": "vitest run src/config/penetration.security.test.ts src/services/auth-enforcement.test.ts",
    "test:services": "vitest run src/services",
    "test:backend:unit": "npm --prefix backend run test -- src/modules/portal/schemas.test.ts src/modules/auth/schemas.test.ts src/modules/emergency/schemas.test.ts",
    "test:backend:security": "npm --prefix backend run test -- src/middleware/rbac.security.test.ts src/middleware/penetration.security.test.ts src/middleware/csrf.test.ts src/modules/auth/service.lockout.test.ts src/modules/auth/password-reset.security.test.ts",
    "test:backend:services": "npm --prefix backend run test -- src/modules/saas/service.test.ts src/modules/payments/chapa.service.test.ts src/modules/clinical-messaging/messaging.test.ts src/modules/media/service.test.ts src/modules/payments/chapa.gateway.test.ts",
    "test:audit": "node scripts/code-audit.cjs",
    "test:all": "npm run typecheck && npm run backend:typecheck && npm run test && npm run backend:test && node scripts/verify-build.cjs && node scripts/code-audit.cjs",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:start": "npm --prefix backend run start",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "backend:test": "npm --prefix backend run test",
    "db:generate": "npm --prefix backend run prisma:generate",
    "db:validate": "npm --prefix backend run prisma:validate",
    "db:seed": "npm --prefix backend run seed"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.5",
    "lucide-react": "^1.72.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
